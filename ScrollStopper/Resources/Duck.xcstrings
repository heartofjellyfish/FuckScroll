    "Doing nothing counts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doing nothing counts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发呆也算休息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發呆也算休息。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hacer nada también cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne rien faire, ça compte aussi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichtstun zählt auch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche non fare niente conta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何もしないのも休憩。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 안 해도 쉬는 거예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não fazer nada também conta."
          }
        }
      }
    },
