    "Screen Time needs a real iPhone. You can explore the interruption here, but this simulator cannot protect other apps.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time needs a real iPhone. You can explore the interruption here, but this simulator cannot protect other apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕使用时间需要真机。这里可以预览界面，但模拟器无法拦截其他 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕使用時間需要實體 iPhone。你可以在這裡預覽提醒，但模擬器無法限制其他 App。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo de uso requiere un iPhone físico. Puedes probar el aviso aquí, pero este simulador no puede bloquear otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps d’écran nécessite un vrai iPhone. Vous pouvez découvrir le rappel ici, mais ce simulateur ne peut pas bloquer d’autres apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmzeit benötigt ein echtes iPhone. Hier kannst du die Erinnerung ausprobieren, aber der Simulator kann keine anderen Apps sperren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo di utilizzo richiede un iPhone fisico. Qui puoi provare il promemoria, ma il simulatore non può bloccare altre app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンタイムには実機のiPhoneが必要です。ここでは通知画面を試せますが、シミュレーターで他のアプリを制限することはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린타임은 실제 iPhone이 필요해요. 여기서는 알림 화면을 살펴볼 수 있지만 시뮬레이터는 다른 앱을 차단할 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tempo de Uso precisa de um iPhone real. Você pode experimentar o lembrete aqui, mas este simulador não pode bloquear outros apps."
          }
        }
      }
    }
  },
  "version": "1.0"
}
