    "Scroll too long. Get cut off.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll too long. Get cut off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷太久，就拦住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑太久，鴨子會喊停。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si te pasas, el pato te para."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu t’éternises, le canard intervient."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu lange gescrollt? Die Ente greift ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se scorri troppo, l’anatra ti ferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見すぎたら、アヒルが止める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 오래 보면 오리가 멈춰 줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passou do tempo? O pato intervém."
          }
        }
      }
    },
    "GO DO\nLITERALLY\nANYTHING.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GO DO\nLITERALLY\nANYTHING."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去干点\n别的。\n随便什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去做點\n別的。\n什麼都好。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HAZ\nCUALQUIER\nOTRA COSA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VA FAIRE\nN’IMPORTE\nQUOI D’AUTRE."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MACH MAL\nIRGENDWAS\nANDERES."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FAI\nQUALCOS’ALTRO.\nQUALSIASI COSA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何か\nほかのこと\nしよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제\n딴 거\n좀 하자."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "VAI FAZER\nQUALQUER\nOUTRA COISA."
          }
        }
      }
    },
