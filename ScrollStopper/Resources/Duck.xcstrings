            "state": "translated",
            "value": "Tus apps y límites se quedan en este dispositivo. Sin cuenta ni anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes apps et tes limites restent sur cet appareil. Ni compte ni pub."
          }
        },
        "de": {
