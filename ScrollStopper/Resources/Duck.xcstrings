    "Steep. Don't scroll.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steep. Don't scroll."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "泡茶，别泡在屏幕里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "泡茶，別泡在螢幕裡。"
