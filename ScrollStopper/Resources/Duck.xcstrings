    "YOU SCROLL.\nI SIP.\nWE TALK.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YOU SCROLL.\nI SIP.\nWE TALK."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你刷。\n我喝。\n聊聊？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你滑。\n我喝。\n聊聊？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TÚ MIRAS.\nYO BEBO.\nHABLEMOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TU DÉFILES.\nJE SIROTE.\nON PARLE."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DU SCROLLST.\nICH TRINKE.\nREDEN WIR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TU SCORRI.\nIO BEVO.\nPARLIAMONE."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "君は見る。\n私は飲む。\n話そうか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넌 넘기고.\n난 마시고.\n얘기 좀 하자."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "VOCÊ ROLA.\nEU BEBO.\nVAMOS CONVERSAR."
          }
        }
      }
    },
