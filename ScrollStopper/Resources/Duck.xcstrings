    "They do more than hold your phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They do more than hold your phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "腿可不只是手机支架。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "腿可不只是手機支架。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus piernas no son un soporte de móvil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes jambes ne servent pas qu’à poser ton téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Beine sind mehr als eine Handyablage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le gambe non sono solo un reggitelefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脚はスマホ置き場だけじゃない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리는 휴대폰 받침대가 아니잖아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas pernas não são só apoio pro celular."
          }
        }
      }
    },
    "Steep. Don't scroll.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steep. Don't scroll."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "泡茶，别泡在屏幕里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "泡茶，別泡在螢幕裡。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja reposar el té, y el móvil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais infuser. Pas défiler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee ziehen lassen. Nicht den Feed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Infusione. Non scorrimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お茶を淹れて、指は休めて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차는 우리고, 스크롤은 쉬고."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa o chá descansar. E o dedo também."
          }
        }
      }
    },
    "It's had enough of you too.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's had enough of you too."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它也想歇会儿，真的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它也想歇會兒，真的。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu móvil también necesita descansar de ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lui aussi a besoin de souffler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Handy braucht auch mal Ruhe vor dir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche lui ha bisogno di una pausa da te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホも君から休みたいって。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰도 당신에게서 좀 쉬고 싶대요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele também precisa de uma pausa de você."
          }
        }
      }
    },
    "Still faster than scrolling.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still faster than scrolling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总比原地刷屏走得远。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "總比原地滑手機走得遠。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aun así avanzas más que deslizando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça avance toujours plus que ton fil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer noch mehr Strecke als beim Scrollen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai comunque più lontano che scorrendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールより前に進んでる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤보단 멀리 가고 있네요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda vai mais longe do que rolando o feed."
          }
        }
      }
