  "sourceLanguage": "en",
  "strings": {
    "YOU WERE\nJUST GOING\nTO CHECK.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YOU WERE\nJUST GOING\nTO CHECK."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本来\n就看\n一眼。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明明\n只想看\n一眼。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SOLO IBAS\nA ECHAR\nUN VISTAZO."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "JUSTE\nUN PETIT\nCOUP D’ŒIL."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NUR MAL\nKURZ\nSCHAUEN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SOLO\nUN’OCCHIATA,\nVERO?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ちょっと\n見るだけの\nはずだった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠깐만\n본다고\n했잖아."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ERA SÓ\nUMA\nOLHADINHA."
          }
        }
      }
    },
