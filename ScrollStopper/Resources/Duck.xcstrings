    "Still locked after time’s up? Open the duck.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still locked after time’s up? Open the duck."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
