    "Stay away for a full break to reset usage.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay away for a full break to reset usage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提前离开满休息时长，用时清零。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
